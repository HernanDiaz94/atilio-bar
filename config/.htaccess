# ==================================================================
#  config/.htaccess
# ------------------------------------------------------------------
#  Esta carpeta tiene config.php con la contraseña de MySQL.
#  Nadie tiene que poder leerla desde el navegador, ni aunque
#  se haya olvidado de protegerla en otro lado.
# ==================================================================

# Bloqueo total
<IfModule mod_authz_core.c>
    Require all denied
</IfModule>
<IfModule !mod_authz_core.c>
    Order allow,deny
    Deny from all
</IfModule>

# Nunca listar esta carpeta
Options -Indexes