# ==================================================================
#  logs/.htaccess
# ------------------------------------------------------------------
#  Acá se guardan los errores de PHP con detalles internos
#  (líneas de código, consultas). Obvio que no se sirven.
# ==================================================================

<IfModule mod_authz_core.c>
    Require all denied
</IfModule>
<IfModule !mod_authz_core.c>
    Order allow,deny
    Deny from all
</IfModule>

Options -Indexes

# No generar listados .txt del log
<FilesMatch "\.(log|txt)$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order allow,deny
        Deny from all
    </IfModule>
</FilesMatch>