# ==================================================================
#  includes/.htaccess
# ------------------------------------------------------------------
#  Código interno de la aplicación. Nadie debe poder abrir estos
#  archivos directamente desde el navegador: si alguien logra
#  include() un archivo suelto, puede saltarse las verificaciones
#  de sesión, rol y CSRF.
# ==================================================================

<IfModule mod_authz_core.c>
    Require all denied
</IfModule>
<IfModule !mod_authz_core.c>
    Order allow,deny
    Deny from all
</IfModule>

Options -Indexes