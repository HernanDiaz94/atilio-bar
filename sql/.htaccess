# ==================================================================
#  sql/.htaccess
# ------------------------------------------------------------------
#  Los archivos .sql contienen la estructura de la base de datos.
#  Descargarlos no rompe nada, pero es información que sirve para
#  entender cómo funciona la aplicación. Mejor que no se sirvan.
# ==================================================================

<IfModule mod_authz_core.c>
    Require all denied
</IfModule>
<IfModule !mod_authz_core.c>
    Order allow,deny
    Deny from all
</IfModule>

Options -Indexes