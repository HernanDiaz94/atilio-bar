# ================================================================
#  .gitignore  ·  Bar "Atilio"
# ------------------------------------------------------------------
#  Qué NO se versiona y por qué.
# ================================================================


# ------------------------------------------------------------
# 1) LOGS DE ERRORES
#    Acá PHP escribe el detalle de los errores: rutas de archivos,
#    números de línea y a veces fragmentos de consultas.
#    No sirve para nada más que para el servidor.
# ------------------------------------------------------------
logs/*.log
*.log


# ------------------------------------------------------------
# 2) CREDENCIALES
# ------------------------------------------------------------
#  config/config.php tiene la contraseña de MySQL del hosting, así
#  que NO se versiona. La exclusión es deliberada y permanente: por
#  diseño, el repo no tiene el archivo con la contraseña.
#
#  Una contraseña que se commiteó queda en el historial para
#  siempre. Borrarla del archivo después no la saca de ahí: sigue
#  disponible con `git log -p`.
#
#  En tu máquina, config/config.php existe y lo editás normal. Para
#  crearlo en una máquina nueva, partí de la plantilla que SÍ está
#  versionada:
#
#      copy config\config.example.php config\config.php
#
#  Si alguna vez versionaste tu config.php con la contraseña real,
#  sacalo del historial con git-filter-repo (o BFG). Avisame y te
#  explico cómo, pero mejor no hacerlo nunca desde el principio.
config/config.php


# ------------------------------------------------------------
# 3) SISTEMA OPERATIVO Y EDITORES
# ------------------------------------------------------------
.DS_Store
Thumbs.db
Thumbs.db:encryptable
desktop.ini
.idea/
.vscode/

# Archivos temporales del editor
*~

# Backups y temporales de un editor
*.swp
*.swo
*.orig
*.old


# ------------------------------------------------------------
# 4) LO QUE SÍ SE VERSIONA
# ------------------------------------------------------------
#  Los .htaccess son configuración del servidor y hacen falta para
#  que el despliegue funcione: sí van al repo.
#  Los archivos .sql también: son el esquema de la base y cada
#  etapa nueva trae el suyo.
#
#  Nota: no hace falta poner "!*.htaccess" ni "!sql/*.sql" porque
#  acá no se ignoran con ningún patrón. Está anotado solo para que
#  quede claro que son deliberados.